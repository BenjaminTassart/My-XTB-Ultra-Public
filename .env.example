# Copie ce fichier en ".env" (en local) ; sur Render, saisis ces valeurs dans "Environment".
# Ne publie JAMAIS le fichier .env sur GitHub.

# Chaine de connexion Supabase : "Connect" > "Session pooler" (pas la connexion directe, qui est en IPv6)
# Laisse vide en local pour utiliser un fichier SQLite de test.
DATABASE_URL=
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
TWELVEDATA_DAILY_LIMIT=800
# Accès aux comptes publics SEC : nom de l’application suivi de ton email de contact.
SEC_USER_AGENT=
ACCESS_CODE=

# Étape 3 : secret distinct du code d’accès
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Étape 4 : clé d’un projet Gemini gratuit sans facturation activée
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_LIMIT=10
